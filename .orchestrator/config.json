{
  "repoRoot": "C:/RogueKostas/ZenRoutine",
  "lanesRoot": "C:/CoworkBridge/lanes",
  "baseBranch": "main",
  "transport": "local",
  "backend": "claude",

  "expectedGhLogin": "RogueKostas",
  "expectedGitEmail": "kostas@roguesun.com",

  "cadenceMinutes": 15,
  "idleCadenceMinutes": 30,
