      "turnFailed": "turn.failed",
      "itemCompleted": "item.completed",
      "agentMessageItemType": "agent_message",
      "probedVersion": null,
      "probedAt": null
    }
  },

  "nodePath": "C:/CoworkBridge/tools/node-v22.23.2-win-x64",

  "forbidden": [
    "git push", "gh auth", "git stash", "--force ", "--skip-",
    "npm publish", "git reset --hard",
    "npm audit fix", "expo prebuild", "eas build", "eas submit",
    "npx expo login", "render"
  ],

  "trackedGeneratedFiles": ["package-lock.json"]
}
